{
  "manifest_version": 3,
  "name": "旺销王质检放大助手",
  "version": "0.7.1",
  "description": "在订单扫码页显示大图、尺码、数量及本单备注。只读当前页面，不提交扫码或验货。",
  "content_scripts": [
    {
      "matches": [
        "https://v3.wxwerp.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "layout.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "旺销王质检放大助手"
  },
  "key": "",
  "permissions": [
    "nativeMessaging",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
